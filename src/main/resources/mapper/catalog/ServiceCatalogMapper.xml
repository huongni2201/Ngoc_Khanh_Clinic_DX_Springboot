<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ngockhanh.clinic.catalog.infrastructure.persistence.mapper.ServiceCatalogMapper">
 <select id="findByIds" resultType="com.ngockhanh.clinic.catalog.application.query.ServiceCatalogQuery$Service">
 SELECT id,code,name,active,unit_price FROM public.services WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
 </select>
 <sql id="activeFilter">active = true <if test="pattern != null">AND (LOWER(code) LIKE #{pattern} ESCAPE chr(92) OR LOWER(name) LIKE #{pattern} ESCAPE chr(92))</if></sql>
 <select id="countActive" resultType="long">SELECT COUNT(*) FROM public.services WHERE <include refid="activeFilter"/></select>
 <select id="findActivePage" resultType="com.ngockhanh.clinic.catalog.application.query.ServiceCatalogQuery$ServiceItem">
 SELECT id,code,name,service_type,unit_price,active FROM public.services WHERE <include refid="activeFilter"/>
 ORDER BY
 <choose>
  <when test="sortKey == 'code' and sortBy == 'DESC'">code DESC, id ASC</when>
  <when test="sortKey == 'code'">code ASC, id ASC</when>
  <when test="sortKey == 'name' and sortBy == 'DESC'">name DESC, id ASC</when>
  <when test="sortKey == 'name'">name ASC, id ASC</when>
  <when test="sortKey == 'unitPrice' and sortBy == 'DESC'">unit_price DESC, id ASC</when>
  <when test="sortKey == 'unitPrice'">unit_price ASC, id ASC</when>
  <when test="sortBy == 'DESC'">id DESC</when>
  <otherwise>id ASC</otherwise>
 </choose>
 LIMIT #{limit} OFFSET #{offset}
 </select>
</mapper>
