<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.mapper.RoleMyBatisMapper">
    <select id="lockByIds" resultType="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.record.RoleRecord">
        SELECT id, code, name, description, active
        FROM public.roles
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        FOR SHARE
    </select>
    <select id="findByCode" resultType="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.record.RoleRecord">
        SELECT id, code, name, description, active FROM public.roles WHERE code = #{code}
    </select>
    <select id="findActiveExcept" resultType="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.record.RoleRecord">
        SELECT id, code, name, description, active
        FROM public.roles
        WHERE active = true AND code &lt;&gt; #{excludedCode}
        ORDER BY name, code
    </select>
</mapper>
