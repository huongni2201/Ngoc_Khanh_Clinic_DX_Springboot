<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.mapper.EndpointPermissionMyBatisMapper">
    <select id="findAll" resultType="com.ngockhanh.clinic.accesscontrol.infrastructure.persistence.projection.EndpointPermissionRow">
        SELECT code AS permission_code, http_method, endpoint
        FROM public.permissions
        WHERE endpoint IS NOT NULL
        ORDER BY endpoint, http_method
    </select>
</mapper>
