<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ngockhanh.clinic.document.infrastructure.persistence.mapper.DocumentTemplateMapper">
 <select id="findEffective" resultType="com.ngockhanh.clinic.document.infrastructure.persistence.mapper.EffectiveVersionRow">
  SELECT v.id AS version_id, v.version_no, v.contract_version, f.storage_provider, f.storage_key, f.checksum, v.pages_per_record
  FROM public.templates t
  JOIN public.template_versions v ON v.template_id=t.id
  JOIN public.files f ON f.id=v.file_id
  WHERE t.template_type=#{templateType} AND t.is_default=true AND t.active=true
  AND v.status='PUBLISHED' AND v.active_from&lt;=#{at} AND (v.retired_at IS NULL OR v.retired_at&gt;#{at})
 </select>
 <select id="lockForSeeding" resultType="int">
  SELECT 1 FROM (SELECT pg_advisory_xact_lock(hashtextextended(#{key}, 0))) AS locked
 </select>
 <select id="hasVersions" resultType="boolean">
  SELECT EXISTS (SELECT 1 FROM public.template_versions v JOIN public.templates t ON t.id=v.template_id WHERE t.template_type=#{templateType})
 </select>
 <select id="findDefaultTemplateId" resultType="java.util.UUID">
  SELECT id FROM public.templates WHERE template_type=#{templateType} AND is_default=true
 </select>
 <insert id="insertDefaultTemplate">
  INSERT INTO public.templates(id,code,name,template_type,active,is_default) VALUES (#{id},#{code},#{name},#{templateType},true,true)
 </insert>
 <insert id="insertFile">
  INSERT INTO public.files(id,storage_provider,storage_key,original_filename,content_type,size_bytes,checksum)
  VALUES (#{id},#{storageProvider},#{storageKey},#{originalFilename},#{contentType},#{sizeBytes},#{checksum})
 </insert>
 <insert id="insertPublishedVersion">
  INSERT INTO public.template_versions(id,template_id,version_no,file_id,paper_size,orientation,render_mode,status,contract_version,page_width_mm,page_height_mm,pages_per_record,active_from,published_at)
  VALUES (#{id},#{templateId},#{versionNo},#{fileId},#{paperSize},#{orientation},#{renderMode},'PUBLISHED',#{contractVersion},#{pageWidthMm,jdbcType=NUMERIC},#{pageHeightMm,jdbcType=NUMERIC},#{pagesPerRecord,jdbcType=SMALLINT},#{publishedAt},#{publishedAt})
 </insert>
</mapper>
